# Copy to ud-1/.env.mobile-qa.local (gitignored). Server-only configuration.
# Set the connection to an EXISTING separate, explicitly isolated Neon QA DB.
# Do not copy DATABASE_URL from the web environment or put it in ud-mobile.
QA_DATABASE_URL=
QA_DATABASE_ISOLATED=true
# Use a host reachable by the intended emulator/device for browser handoffs.
# Android emulator may use http://10.0.2.2:3001; a shared private LAN origin
# allows both a desktop browser and physical device to reach the same server.
MOBILE_DEV_APP_ORIGIN=http://localhost:3001
