# Local development. Copy to .env; never commit real secrets.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=

# Dedicated, disposable database for write-capable integration checks.
# Never point this at the application database or set the confirmation for production.
QA_DATABASE_URL=
QA_DATABASE_ISOLATED=false

# Existing social identities keep their stable IDs. Set true only after migration audit.
SOCIAL_PASSWORD_MIGRATION_COMPLETE=false
# Temporary migration-only credentials, never public browser keys.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL="ManForth by B1-Way <support-mf@b1-way.pl>"
RESEND_REPLY_TO_EMAIL=support-mf@b1-way.pl
RESEND_WEBHOOK_SECRET=
# Independent random secret, at least 32 characters. Keep stable for queued encrypted mail.
EMAIL_PROTECTION_SECRET=
EMAIL_SUPPRESSION_SCOPE=b1-way-team
# Enable forwarded-IP trust only behind an ingress that strips/spoof-proofs these headers.
TRUST_PROXY_IP=false
SIGNUP_SOURCE_REQUESTS_PER_HOUR=20
SIGNUP_RECIPIENTS_PER_SOURCE_PER_DAY=10
EMAIL_GLOBAL_DAILY_BUDGET=200
RECOVERY_EMAILS_PER_DAY=3
EMAIL_CHANGE_EMAILS_PER_DAY=3

# Membership catalogue: node --import tsx scripts/billing-setup.mjs --apply
# IDs must belong to this ManForth product and the configured Stripe environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_PRODUCT_ID=
STRIPE_ANNUAL_PRICE_PLN=
STRIPE_ANNUAL_PRICE_GBP=
STRIPE_ANNUAL_PRICE_EUR=
STRIPE_ANNUAL_PRICE_USD=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LEGACY_ANNUAL_PRICE_IDS=
B1_BILLING_SOURCES_ENABLED=false
# production grants access only from production providers; test is local-only.
B1_BILLING_ENVIRONMENT=production
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_ANNUAL_PRODUCT_IDS=
STRIPE_AUTOMATIC_TAX=false
STRIPE_TAX_SETUP_CONFIRMED=false
STRIPE_LIVE_LAUNCH_CONFIRMED=false
TRIAL_DAYS=14
BILLING_GRACE_DAYS=3
# Leave enforcement off until the existing-account cutover has been approved and communicated.
B1_WAY_ENFORCE_MEMBERSHIP=false
B1_WAY_LEGACY_CREATED_BEFORE=
B1_WAY_LEGACY_ACCESS_UNTIL=

# POST /api/account/jobs with Authorization: Bearer <secret>, e.g. every five minutes.
CRON_SECRET=
# Publish reviewed documents before enabling live billing; do not invent legal retention.
POLICY_TERMS_URL=
POLICY_PRIVACY_URL=
POLICY_RETENTION_NOTICE=

# Display identity / canonical only. Auth and checkout callbacks still use APP_URL.
# Legacy setting: public discovery URLs are pinned to the approved origin in lib/brand.ts.
# APP_URL / BETTER_AUTH_URL still configure authentication independently.
NEXT_PUBLIC_SITE_ORIGIN=https://b1-way-mf.vercel.app
# Optional verified language-product destination; its membership is separate.
LANGUAGE_PRODUCT_URL=

# Public Terms/Privacy operator facts. Required fields below render local website copy.
# No legal-document or signup acceptance records are written to the database.
# Copy these server-only values to the deployment environment and rebuild.
# These values never approve or publish documents automatically.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_FORM=
LEGAL_OPERATOR_COUNTRY=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_REGISTRATION=
LEGAL_OPERATOR_TAX=
# Individual operators do not need invented company details. Record applicability privately.
# provided = applicable and supplied; not-applicable = explicitly confirmed; unresolved = unknown.
LEGAL_OPERATOR_REGISTRATION_STATUS=unresolved
LEGAL_OPERATOR_TAX_STATUS=unresolved
LEGAL_CONTACT_EMAIL=
# Localhost production preview only; ignored on Vercel production.
LEGAL_DRAFT_PREVIEW=false

# Comma-separated existing account IDs allowed to publish INTERNAL app messages
# through the server-only operator command. Empty disables publication.
NOTIFICATION_OPERATOR_IDS=
